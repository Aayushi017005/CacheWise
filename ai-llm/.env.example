PORT=5001
NODE_ENV=development

# LLM Provider configuration: "gemini", "openai", or leave blank for educational fallback
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Request timeout in milliseconds
LLM_TIMEOUT_MS=8000

